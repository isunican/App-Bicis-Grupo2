@startuml domain

hide empty members

class Network {
    - id : String
    - name : String
    - href : String
    - company : String[]
    - gbfsHref : String
    - ebikes : boolean
}

class Location {
    - city : String
    - country : String
}

class Station {
    - id : String
    - name : String
    - latitude : double
    - longitude : double
    - freeBikes : Integer
    - emptySlots : Integer
    - timestamp : String
}

class Country {
    - name : String
    - idISO : String
    - idAPI : String
    - flag : String
    --
    + Country:find(Map<String, Country> all, String idAPI)
    + String:getCountryFlag(Map<String, Country> all, String idAPI)
    - Country:unknown(String idAPI)
}

enum Availability {
    HIGH
    LOW
    NONE
    UNKNOWN
    --
    +bikesAvailability(Integer freeBikes): Availability
}

class CountryResponse {
}

class FavoriteStation {
    - stationId : String
    - networkId : String
    - alias : String
    - stationName : String
    - country: String
    - city: String
    --
    +FavoriteStation()
    +FavoriteStation(stationId : String, networkId : String, alias : String, 
    stationName : String, country: String, city: String)
}



class NetworksResponse {

}

class NetworkResponse {

}

note "Se incluyen las clases wrapper NetworksResponse y NetworkResponse\npara reflejar la estructura del paquete model implementado\npara el consumo de la API CityBikes" as NoteWrapper
NetworksResponse .. NoteWrapper
NetworkResponse .. NoteWrapper

Network *--> "1" Location : location
Network *--> "*" Station : stations
NetworksResponse *--> "*" Network : networks
NetworkResponse *--> "1" Network : network
CountryResponse *--> "*" Country : country

@enduml