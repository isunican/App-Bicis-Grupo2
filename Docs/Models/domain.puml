@startuml domain

hide empty members

class Network {
    - id : String
    - name : String
    - href : String
    - company : String[]
    - gbfsHref : String
    - ebikes : boolean
}

class Location {
    - city : String
    - country : String
}

class Station {
    # id : String
    # name : String
    # latitude : Double
    # longitude : Double
    # freeBikes : Integer
    # emptySlots : Integer
    # timestamp : String
    --
    + hasElectricBikes() : boolean
    + ebikes() : int
}

class StationExtra {
    # ebikes : Integer
    # hasEbikes : Boolean
}

class AlternativeStation {
    - distanceToFavoriteKm : double
    - distanceToUserKm : Double
}

class StationEbikesFilter {
    # available : boolean
    # notAvailable : boolean
    --
    + applyFilter(stations : List<Station>) : List<Station>
}

class Country {
    - name : String
    - idISO : String
    - idAPI : String
    - flag : String
    --
    + Country:find(Map<String, Country> all, String idAPI)
    + String:getCountryFlag(Map<String, Country> all, String idAPI)
    - Country:unknown(String idAPI)
}

enum Availability {
    HIGH
    LOW
    NONE
    UNKNOWN
    --
    + bikesAvailability(Integer freeBikes) : Availability
}

class CountriesResponse {
}

class FavoriteStation {
    - stationId : String
    - networkId : String
    - alias : String
    - stationName : String
    - country : String
    - city : String
    --
    + FavoriteStation()
    + FavoriteStation(stationId : String, networkId : String, alias : String, stationName : String, country : String, city : String)
}

class NetworksResponse {
}

class NetworkResponse {
}

note "Se incluyen las clases wrapper NetworksResponse, NetworkResponse y CountriesResponse\npara reflejar la estructura del paquete model implementado\npara el consumo de la API" as NoteWrapper
NetworksResponse .. NoteWrapper
NetworkResponse .. NoteWrapper
CountriesResponse .. NoteWrapper

' Relaciones estructurales
Network *--> "1" Location : location
Network *--> "*" Station : stations
Station *--> "0..1" StationExtra : extra
AlternativeStation --> "1" Station : station

' Wrappers de respuesta
NetworksResponse *--> "*" Network : networks
NetworkResponse *--> "1" Network : network
CountriesResponse *--> "*" Country : countries

' Dependencias de comportamiento
StationEbikesFilter ..> Station : filters

@enduml