<?xml version="1.0" encoding="utf-8"?>
<resources>
    <color name="black">#FF000000</color>
    <color name="white">#FFFFFFFF</color>

    <!--   Color for the app bar and other primary UI elements. -->
    <color name="colorPrimary">#13C89B</color>

    <!--   A darker variant of the primary color, used for
           the status bar (on Android 5.0+) and contextual app bars. -->
    <color name="colorPrimaryDark">#0EB1A5</color>

    <!-- A more translucent variant of the primary color, used for
         the background color of the filters bar.-->
    <color name="colorPrimaryTranslucent">#5113C89B</color>

    <!--   a secondary color for controls like checkboxes and text fields. -->
    <color name="colorAccent">#FF4081</color>

    <color name="colorTitle">#0E6088</color>

    <!--   Availability of bikes in a station (more than 3, between 1 and 3, none, unknown). -->
    <color name="availabilityHigh">#FF4CAF50</color>
    <color name="availabilityLow">#FFFF9800</color>
    <color name="availabilityNone">#FFF44336</color>
    <color name="availabilityUnknown">#FF9E9E9E</color>

</resources>